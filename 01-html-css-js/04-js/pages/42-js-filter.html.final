<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>filter</title>
  </head>
  <body>
    <p>結果在 DevTools 的 Console。</p>
    <script>
      const scores = [88, 92, 76, 95, 61];

      const passed = scores.filter((score) => score >= 80);

      console.log(passed);
      console.log(scores);
      console.log(scores.length);
    </script>
  </body>
</html>
