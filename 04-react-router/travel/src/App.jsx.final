import { useEffect, useState } from 'react';
import {
  Link,
  NavLink,
  Outlet,
  Route,
  Routes,
  useNavigate,
  useParams,
} from 'react-router';
import { createItem, getItems } from './api/fake-api.js';

const itemClass = ({ isActive }) =>
  isActive ? 'text-teal-800 underline' : 'text-stone-700';

function SiteMenu() {
  return (
    <header className="border-b border-stone-200 bg-white">
      <nav className="mx-auto flex max-w-3xl gap-4 px-4 py-3">
        <NavLink to="/" end className={itemClass}>
          首頁
        </NavLink>
        <NavLink to="/items" className={itemClass}>
          清單
        </NavLink>
        <NavLink to="/new" className={itemClass}>
          新增
        </NavLink>
      </nav>
    </header>
  );
}

function HomePage() {
  return (
    <section>
      <h1 className="text-2xl font-bold">洛奇旅行</h1>
      <p className="mt-2">城市散步、山海與社寺。</p>
      <p className="mt-4">
        <Link className="text-teal-800 underline" to="/items">
          看清單
        </Link>
      </p>
    </section>
  );
}

function ListPage() {
  const [items, setItems] = useState([]);
  const [status, setStatus] = useState('loading');

  useEffect(() => {
    const load = async () => {
      try {
        setItems(await getItems());
        setStatus('ready');
      } catch {
        setStatus('error');
      }
    };
    load();
  }, []);

  if (status === 'loading') return <p>載入中</p>;
  if (status === 'error') return <p>讀取失敗</p>;

  return (
    <ul className="grid gap-2">
      {items.map((item) => (
        <li
          key={item.id}
          className="rounded border border-stone-200 bg-white p-4"
        >
          <p className="font-semibold">{item.title}</p>
          <p className="mt-1">
            {item.place} {item.days} 天 {item.price}
          </p>
          <p className="mt-3">
            <Link className="text-teal-800 underline" to={'/items/' + item.id}>
              看這一筆
            </Link>
          </p>
        </li>
      ))}
    </ul>
  );
}

function DetailPage() {
  const { id } = useParams();
  const [status, setStatus] = useState('loading');
  const [item, setItem] = useState(null);

  useEffect(() => {
    const load = async () => {
      try {
        const items = await getItems();
        setItem(items.find((row) => String(row.id) === id) ?? null);
        setStatus('ready');
      } catch {
        setStatus('error');
      }
    };
    load();
  }, [id]);

  if (status === 'loading') return <p>載入中</p>;
  if (status === 'error') return <p>讀取失敗</p>;
  if (!item) return <p>找不到這筆</p>;

  return (
    <article>
      <h1 className="text-2xl font-bold">{item.title}</h1>
      <p className="mt-2">
        {item.place} {item.days} 天 {item.price}
      </p>
    </article>
  );
}

function NewPage() {
  const navigate = useNavigate();
  const [title, setTitle] = useState('');
  const [place, setPlace] = useState('');
  const [days, setDays] = useState('');
  const [price, setPrice] = useState('');
  const [message, setMessage] = useState('');

  const onSubmit = async (event) => {
    event.preventDefault();
    if (!title) return;
    setMessage('');
    try {
      await createItem({
        title,
        place,
        days: Number(days),
        price: Number(price),
      });
      navigate('/items');
    } catch {
      setMessage('送出失敗');
    }
  };

  return (
    <form onSubmit={onSubmit} className="grid max-w-sm gap-3">
      <input
        value={title}
        onChange={(event) => setTitle(event.target.value)}
        className="rounded border px-2 py-1"
        placeholder="標題"
      />
      <input
        value={place}
        onChange={(event) => setPlace(event.target.value)}
        className="rounded border px-2 py-1"
        placeholder="地點"
      />
      <input
        value={days}
        onChange={(event) => setDays(event.target.value)}
        className="rounded border px-2 py-1"
        placeholder="天數"
      />
      <input
        value={price}
        onChange={(event) => setPrice(event.target.value)}
        className="rounded border px-2 py-1"
        placeholder="價格"
      />
      <button
        type="submit"
        className="rounded bg-teal-800 px-3 py-1 text-white"
      >
        送出並回到清單
      </button>
      {message ? <p>{message}</p> : null}
    </form>
  );
}

function NotFoundPage() {
  return (
    <section>
      <h1 className="text-2xl font-bold">找不到頁面</h1>
      <p className="mt-2">
        <Link className="text-teal-800 underline" to="/">
          回首頁
        </Link>
      </p>
    </section>
  );
}

function Layout() {
  return (
    <div className="min-h-screen bg-stone-50 text-stone-900">
      <SiteMenu />
      <main className="mx-auto max-w-3xl px-4 py-6">
        <Outlet />
      </main>
    </div>
  );
}

export default function App() {
  return (
    <Routes>
      <Route path="/" element={<Layout />}>
        <Route index element={<HomePage />} />
        <Route path="items" element={<ListPage />} />
        <Route path="items/:id" element={<DetailPage />} />
        <Route path="new" element={<NewPage />} />
        <Route path="*" element={<NotFoundPage />} />
      </Route>
    </Routes>
  );
}
